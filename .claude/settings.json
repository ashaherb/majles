{
  "fallbackModel": ["opus"],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(**/.env)",
      "Read(./.env.local)",
      "Read(**/.env.local)",
      "Read(./.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(./.env.development)",
      "Read(**/.env.development)",
      "Read(./.env.production)",
      "Read(**/.env.production)",
      "Read(./.env.staging)",
      "Read(**/.env.staging)",
      "Read(./.env.test)",
      "Read(**/.env.test)",
      "Read(./*.pem)",
      "Read(**/*.pem)",
      "Read(./*.key)",
      "Read(**/*.key)",
      "Read(./*service-account*.json)",
      "Read(**/*service-account*.json)",
      "Read(./serviceAccountKey*.json)",
      "Read(**/serviceAccountKey*.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v majles >/dev/null 2>&1 && majles check \"$CLAUDE_PROJECT_DIR\" 2>/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
