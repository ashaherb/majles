{
  "fallbackModel": ["opus"],
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "command -v majles >/dev/null 2>&1 && majles check \"$CLAUDE_PROJECT_DIR\" 2>/dev/null; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
